{
  "name": "lotgrade",
  "version": "0.0.0",
  "private": true,
  "description": "A focused cross-platform residential lot drawing and grading workspace.",
  "type": "module",
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/build-desktop.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src desktop scripts \"tests/*.ts\" *.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src desktop scripts \"tests/*.ts\" *.config.ts package.json tsconfig.json",
    "setup:hooks": "node scripts/install-hooks.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:interop": "node --import tsx scripts/generate-export-fixtures.ts && node scripts/run-interop.mjs",
    "test:e2e": "playwright test",
    "package": "npm run check && npm run test:interop && node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
